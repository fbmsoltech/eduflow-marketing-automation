# Copy this file to infra/azure/env.local and replace placeholders.
# Never commit env.local or real credentials.

AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-eduflow-dev
AZURE_LOG_ANALYTICS_WORKSPACE=log-eduflow-dev
AZURE_CONTAINERAPPS_ENVIRONMENT=cae-eduflow-dev

AZURE_POSTGRES_SERVER=eduflow-dev-unique
AZURE_POSTGRES_DATABASE=eduflow
AZURE_POSTGRES_ADMIN_USER=eduflowadmin
AZURE_POSTGRES_ADMIN_PASSWORD=
AZURE_POSTGRES_SKU=Standard_B1ms
AZURE_POSTGRES_VERSION=16
# 0.0.0.0 allows connections from Azure services and is only an initial deployment setting.
AZURE_POSTGRES_PUBLIC_ACCESS=0.0.0.0

AZURE_REDIS_NAME=eduflow-dev-unique
AZURE_REDIS_SKU=Basic
AZURE_REDIS_VM_SIZE=c0

CONTAINER_IMAGE=ghcr.io/fbmsoltech/eduflow-marketing-automation:latest
# Must reference an image that includes Prisma CLI, schema and migrations.
MIGRATIONS_IMAGE=

API_APP_NAME=eduflow-api
OUTBOX_WORKER_APP_NAME=eduflow-outbox-worker
AUTOMATION_WORKER_APP_NAME=eduflow-automation-worker
MIGRATIONS_JOB_NAME=eduflow-migrations

API_MIN_REPLICAS=1
API_MAX_REPLICAS=1
WORKER_MIN_REPLICAS=1
WORKER_MAX_REPLICAS=1

NODE_ENV=production
LOG_LEVEL=info
APP_PORT=3000

# Cloud URLs must never use localhost. URL-encode credentials embedded in URLs.
DATABASE_URL=
REDIS_URL=
RABBITMQ_URL=

RABBITMQ_EXCHANGE=eduflow.events
RABBITMQ_EXCHANGE_TYPE=topic
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=5000
OUTBOX_PUBLISH_LIMIT=100
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_QUEUE=eduflow.automation.events
AUTOMATION_WORKER_BINDING_KEY=lead-events.#
AUTOMATION_WORKER_PREFETCH=10
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=1000

# Leave both empty for a public GHCR package.
# A private package requires a token with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=

