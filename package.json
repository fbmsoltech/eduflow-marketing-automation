{
  "name": "eduflow-marketing-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven marketing automation platform for academic campaigns.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p apps/api/tsconfig.app.json",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api outbox-publisher-worker automation-worker",
    "docker:ps": "docker compose ps",
    "docker:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis rabbitmq",
    "infra:ps": "docker compose ps",
    "infra:up": "docker compose up -d postgres redis rabbitmq",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "start": "node dist/apps/api/main.js",
    "start:dev": "nest start api --watch",
    "start:worker:outbox": "ts-node apps/api/src/workers/outbox-publisher/main.ts",
    "start:worker:outbox:prod": "node dist/apps/api/workers/outbox-publisher/main.js",
    "start:worker:automation": "ts-node apps/api/src/workers/automation/main.ts",
    "start:worker:automation:prod": "node dist/apps/api/workers/automation/main.js",
    "lint": "eslint \"apps/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml}\"",
    "prepare": "husky",
    "test": "jest --config jest.config.cjs",
    "test:e2e": "jest --config apps/api/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.20",
    "@nestjs/core": "^11.1.20",
    "@nestjs/platform-express": "^11.1.20",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "amqplib": "^2.0.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.21.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.20",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "multer": "2.2.0"
  },
  "allowScripts": {
    "@nestjs/core@11.1.20": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
